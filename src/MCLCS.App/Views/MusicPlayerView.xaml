<UserControl x:Class="MCLCS.App.Views.MusicPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVisibility"/>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 音源切换 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="音源：" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>
            <Button Content="本地文件夹" Command="{Binding SetSourceCommand}" CommandParameter="Local"
                    Padding="10,4" Margin="0,0,6,0"/>
            <Button Content="在线流媒体" Command="{Binding SetSourceCommand}" CommandParameter="Online"
                    Padding="10,4" Margin="0,0,6,0"/>
            <Button Content="MC 原声" Command="{Binding SetSourceCommand}" CommandParameter="McOst"
                    Padding="10,4"/>
        </StackPanel>

        <!-- 当前曲目 + 传输控制 -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding CurrentTrackDisplay}" TextTrimming="CharacterEllipsis"/>
                <TextBlock FontSize="11" Opacity="0.6" Text="{Binding StatusText}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="⏮" Command="{Binding PreviousCommand}" Width="38" Height="34" FontSize="14" Margin="0,0,6,0"/>
                    <Button Command="{Binding PlayPauseCommand}" Width="46" Height="34" FontSize="15"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="⏸"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⏭" Command="{Binding NextCommand}" Width="38" Height="34" FontSize="14" Margin="0,0,12,0"/>
                    <Button Content="🔁" Command="{Binding SetModeCommand}" Width="38" Height="34" FontSize="13"
                            ToolTip="{Binding Mode}"/>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider Minimum="0" Maximum="100" Width="140" Value="{Binding Volume}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 音源专属操作 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <!-- 本地 -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}">
                <Button Content="加载音乐文件夹" Command="{Binding LoadLocalFolderCommand}"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                        Padding="10,4"/>
            </StackPanel>
            <!-- 在线流媒体 -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding OnlineUrl, UpdateSourceTrigger=PropertyChanged}" Width="320"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}" ToolTip="在线流媒体地址（直接播放链接）"/>
                <Button Content="添加" Command="{Binding AddOnlineCommand}" Margin="8,0,0,0" Padding="10,4"/>
                <TextBlock Text="预设：" VerticalAlignment="Center" Margin="12,0,4,0" Opacity="0.7"/>
                <ComboBox Width="220" ItemsSource="{Binding OnlinePresets}" SelectedItem="{Binding OnlineUrl, Mode=TwoWay}"
                          Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"/>
            </StackPanel>
            <!-- MC 原声 -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMcOst, Converter={StaticResource BoolToVisibility}}">
                <Button Content="扫描 MC 原声" Command="{Binding ScanMcOstCommand}"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="10,4"/>
                <TextBlock Text="{Binding McOstStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"/>
            </StackPanel>
        </StackPanel>

        <!-- 列表 -->
        <Grid Grid.Row="3">
            <!-- 本地 / 在线：统一播放列表 -->
            <ListBox ItemsSource="{Binding Tracks}" Visibility="{Binding IsMcOst, Converter={StaticResource InvBoolToVisibility}}"
                      Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                      BorderBrush="{DynamicResource InputBorder}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Display}" Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- MC 原声：按分类分组 -->
            <ScrollViewer Visibility="{Binding IsMcOst, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding McOstGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,4,0,4" Opacity="0.85"/>
                                <ItemsControl ItemsSource="{Binding Tracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Title}"
                                                    Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"
                                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
