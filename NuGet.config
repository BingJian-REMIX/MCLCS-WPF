<?xml version="1.0" encoding="utf-8"?>
<!--
  沙箱 / 内网构建用的包源配置。
  nuget.org 在部分网络环境不可达，这里改用华为云镜像（完整代理 nuget.org，包内容一致）。
  如果本机能直连 nuget.org，删掉本文件即可恢复默认行为。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" />
  </packageSources>
</configuration>
