<UserControl x:Class="MCLCS.App.Views.AiAssistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels">
    <UserControl.DataContext>
        <vm:AiAssistViewModel/>
    </UserControl.DataContext>

    <DockPanel Margin="18" LastChildFill="True">

        <!-- 标题 -->
        <TextBlock DockPanel.Dock="Top" Text="AI 助手" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

        <!-- 底部：快捷操作 + 输入 + 发送 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource GhostButtonStyle}" Content="崩溃分析" Command="{Binding CrashCommand}" Margin="0,0,6,0"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="Mod 翻译" Command="{Binding TranslateCommand}" Margin="0,0,6,0"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="配装推荐" Command="{Binding RecommendCommand}" Margin="0,0,6,0"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="年度总结" Command="{Binding SummaryCommand}"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         MinHeight="44" MaxHeight="120" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,8,0"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryForeground}" BorderBrush="{DynamicResource InputBorder}"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="发送" MinWidth="72" Height="44"
                        Command="{Binding SendCommand}" VerticalAlignment="Bottom"/>
            </Grid>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 对话区 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,4,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6,0,0">

                            <!-- 用户气泡（右对齐）-->
                            <Border Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource AccentBrush}" CornerRadius="12,12,4,12"
                                    Padding="10,8" MaxWidth="560" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Content}" Foreground="White" TextWrapping="Wrap" FontSize="13"/>
                            </Border>

                            <!-- 助手气泡（左对齐 + 头像）-->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisInvert}}">
                                <Border Width="30" Height="30" CornerRadius="15"
                                        Background="{DynamicResource ControlBackground}"
                                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Margin="0,0,8,0">
                                    <Grid>
                                        <!-- 品牌 logo：白色圆形衬底确保在暗色主题下也能看清深色 favicon -->
                                        <Border Width="22" Height="22" CornerRadius="11" Background="White"
                                                Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}, Path=DataContext.HasLogo, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}, Path=DataContext.AssistantLogo}"
                                                   Stretch="Uniform" Margin="2"/>
                                        </Border>
                                        <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}, Path=DataContext.HasLogo, Converter={StaticResource BoolToVisInvert}}"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource ControlBackground}" CornerRadius="12,12,12,4"
                                        Padding="10,8" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" MaxWidth="640">
                                    <TextBlock Text="{Binding Content}" Foreground="{DynamicResource PrimaryForeground}" TextWrapping="Wrap" FontSize="13"/>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
