<UserControl x:Class="MCLCS.App.Views.SeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:SeedViewModel}">
    <UserControl.DataContext>
        <vm:SeedViewModel/>
    </UserControl.DataContext>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：提取 / 创建 -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="存档种子" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ComboBox ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave, Mode=TwoWay}"
                          Width="220" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                          BorderBrush="{DynamicResource InputBorder}"/>
                <Button Content="刷新" Command="{Binding RefreshSavesCommand}" Width="60" Margin="8,0,0,0" Padding="0,2"/>
            </StackPanel>
            <TextBlock>
                <Run Text="提取到的种子："/>
                <Run Text="{Binding ExtractedSeed}" FontWeight="Bold"/>
            </TextBlock>

            <TextBlock Text="按种子创建世界" FontSize="14" FontWeight="Bold" Margin="0,16,0,8"/>
            <TextBlock Text="世界名称" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBox Text="{Binding NewWorldName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <TextBlock Text="种子（整数）" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBox Text="{Binding NewSeedText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <Button Content="创建世界" Command="{Binding CreateWorldCommand}" Width="100" HorizontalAlignment="Left"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="0,4"/>
        </StackPanel>

        <!-- 右：在线搜索 -->
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="在线种子库" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="200"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}" VerticalContentAlignment="Center"/>
                <Button Content="搜索" Command="{Binding SearchCommand}" Width="70" Margin="8,0,0,0" Padding="0,2"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding SearchResults}" Height="360"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock FontWeight="Bold" Text="{Binding Seed}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForeground}"
                                       Text="{Binding Title}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource StatusForeground}" Margin="0,8,0,0"
                   VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
