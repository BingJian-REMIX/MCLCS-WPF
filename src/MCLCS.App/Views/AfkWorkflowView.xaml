<UserControl x:Class="MCLCS.App.Views.AfkWorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="860"
             d:DataContext="{d:DesignInstance vm:AfkWorkflowViewModel}">
    <UserControl.DataContext>
        <vm:AfkWorkflowViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：动作列表 + 编辑 -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <Button Content="+ 添加动作" Command="{Binding AddActionCommand}" Width="90" Padding="0,4"/>
                <Button Content="删除" Command="{Binding RemoveActionCommand}" Width="60" Padding="0,4" Margin="4,0,0,0"/>
                <Button Content="↑" Command="{Binding MoveUpCommand}" Width="36" Padding="0,2" Margin="4,0,0,0"
                        FontWeight="Bold"/>
                <Button Content="↓" Command="{Binding MoveDownCommand}" Width="36" Padding="0,2" Margin="2,0,0,0"
                        FontWeight="Bold"/>
            </WrapPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}"
                     Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ActionType}" FontSize="10" Foreground="White"
                                           FontWeight="Bold" Width="14" TextAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForeground}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 编辑选中动作 -->
            <Border Grid.Row="2" Background="{DynamicResource ControlBackground}" CornerRadius="6"
                    Padding="10,8" Margin="0,6,0,0">
                <StackPanel Visibility="{Binding SelectedAction, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <TextBlock Text="动作类型：" VerticalAlignment="Center" Width="70"
                                   Foreground="{DynamicResource SecondaryForeground}"/>
                        <ComboBox SelectedItem="{Binding SelectedAction.ActionType}" Width="100">
                            <ComboBoxItem Content="帧率限制 (F)" Tag="F"/>
                            <ComboBoxItem Content="渲染距离 (D)" Tag="D"/>
                            <ComboBoxItem Content="音量 (V)" Tag="V"/>
                            <ComboBoxItem Content="视角朝向 (L)" Tag="L"/>
                            <ComboBoxItem Content="模拟按键 (K)" Tag="K"/>
                            <ComboBoxItem Content="鼠标连点 (C)" Tag="C"/>
                            <ComboBoxItem Content="循环 (*)" Tag="*"/>
                        </ComboBox>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="参数：" VerticalAlignment="Center" Width="70"
                                   Foreground="{DynamicResource SecondaryForeground}"/>
                        <TextBox Text="{Binding SelectedAction.Param, UpdateSourceTrigger=PropertyChanged}"
                                 Width="160" Padding="4,2"
                                 Background="{DynamicResource InputBackground}"
                                 Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorder}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Token 预览 -->
            <Border Grid.Row="3" Background="{DynamicResource ControlBackground}" CornerRadius="6"
                    Padding="10,8" Margin="0,6,0,0">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Token：" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                        <TextBlock Text="{Binding TokenText}" Margin="8,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        <Button Content="复制" Command="{Binding CopyTokenCommand}" Width="56" Padding="0,2"
                                Margin="12,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 右侧：保存/载入/导入 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="保存工作流" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <TextBox Text="{Binding WorkflowName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>
                <Button Content="保存" Command="{Binding SaveCommand}" Width="80" Padding="0,4"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="导入 Token" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <TextBox Text="{Binding ImportToken, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Height="48"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>
                <Button Content="从 Token 导入" Command="{Binding ImportCommand}" Width="100" Padding="0,4"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="已保存的工作流" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <ListBox ItemsSource="{Binding SavedNames}" Background="{DynamicResource ControlBackground}"
                         BorderBrush="{DynamicResource ControlBorder}" MaxHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <Button Grid.Column="1" Content="载入" Width="48" Padding="0,2"
                                        Command="{Binding DataContext.LoadCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="✕" Width="30" Padding="0,2"
                                        Command="{Binding DataContext.DeleteCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Foreground="#E74C3C"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
