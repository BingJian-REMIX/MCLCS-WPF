<Window x:Class="MCLCS.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="发现新版本" Width="480" Height="440">
    <Grid x:Name="RootGrid">
        <!-- 半透明遮罩（覆盖整个 Owner 窗口） -->
        <Rectangle Fill="#80000000"/>

        <!-- 居中卡片 -->
        <Border x:Name="Card" Width="460" MaxHeight="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource WindowBackground}" CornerRadius="14" Padding="22"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForeground}" Text="发现新版本"/>
                <TextBlock x:Name="SubtitleText" DockPanel.Dock="Top" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource SecondaryForeground}" Text=""/>

                <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" x:Name="LaterButton" Content="稍后" Width="84" Padding="0,8"
                            Margin="0,0,10,0" Background="{DynamicResource ControlBackground}"
                            Foreground="{DynamicResource PrimaryForeground}" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorder}" Click="Later_Click"/>
                    <Button Grid.Column="2" x:Name="DownloadButton" Content="前往下载" Width="104" Padding="0,8"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                            Click="Download_Click"/>
                </Grid>

                <!-- 更新日志（可滚动、可复制） -->
                <TextBox x:Name="ChangelogBox" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource PrimaryForeground}" FontSize="13"
                         VerticalContentAlignment="Top"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
