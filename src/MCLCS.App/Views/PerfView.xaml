<UserControl x:Class="MCLCS.App.Views.PerfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels">
    <UserControl.DataContext>
        <vm:PerfViewModel/>
    </UserControl.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="运行实例与性能" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Margin="16,0,0,0" Padding="0,2"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="运行实例"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding Instances.Count}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="12" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="CPU 逻辑核数"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding ProcessorCount}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="12" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="可用内存"/>
                    <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding MemoryUsageText}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="12" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="CPU 占用"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding CpuUsageText}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="累计游玩(分钟)"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding Stats.TotalPlayMinutes}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- bug2.txt #7：taskmgr 式逐实例实时资源表（版本/PID/CPU/内存/启动时间），由 VM 定时器刷新 -->
        <ListView Grid.Row="2" ItemsSource="{Binding Instances}"
                  Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                  BorderBrush="{DynamicResource InputBorder}">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                    <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                    <Setter Property="Padding" Value="6,3"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="版本" Width="170" DisplayMemberBinding="{Binding VersionId}"/>
                    <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                    <GridViewColumn Header="CPU" Width="70" DisplayMemberBinding="{Binding CpuText}"/>
                    <GridViewColumn Header="内存" Width="100" DisplayMemberBinding="{Binding MemoryText}"/>
                    <GridViewColumn Header="启动时间" Width="170" DisplayMemberBinding="{Binding StartedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
