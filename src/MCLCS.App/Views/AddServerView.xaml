<UserControl x:Class="MCLCS.App.Views.AddServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels"
             Width="380">
    <UserControl.DataContext>
        <vm:AddServerViewModel/>
    </UserControl.DataContext>

    <StackPanel Margin="16">
        <TextBlock Text="服务器名称" FontWeight="Bold" Margin="0,0,0,4"
                   Foreground="{DynamicResource PrimaryForeground}"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                 BorderBrush="{DynamicResource InputBorder}"/>

        <TextBlock Text="服务器地址（IP:端口）" FontWeight="Bold" Margin="0,12,0,4"
                   Foreground="{DynamicResource PrimaryForeground}"/>
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                 BorderBrush="{DynamicResource InputBorder}"/>

        <TextBlock Text="{Binding Error}" Foreground="#E74C3C" FontSize="12" Margin="0,8,0,0"
                   TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="72" Padding="0,4" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="确定" Width="72" Padding="0,4"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
