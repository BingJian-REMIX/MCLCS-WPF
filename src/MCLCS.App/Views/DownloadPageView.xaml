<UserControl x:Class="MCLCS.App.Views.DownloadPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels"
             xmlns:theme="clr-namespace:MCLCS.App.Themes"
             xmlns:conv="clr-namespace:MCLCS.App.Converters"
             xmlns:ctrl="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
    <UserControl.Resources>
        <ctrl:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVisibility"/>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility"/>

        <!-- 卡片角标：地图的"含附加资源"等小标签 -->
        <Style x:Key="CardBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 详情窗元信息行 -->
        <Style x:Key="DetailMetaLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="DetailMetaValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索（始终） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,4">
            <TextBox Width="240" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索关键词"/>
            <Button Content="搜索" Command="{Binding SearchCommand}" Margin="8,0,0,0" Padding="12,2"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"/>
        </StackPanel>

        <!-- 筛选行：Modrinth 风格（版本 + 加载器，不含整合包） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8"
                    Visibility="{Binding ModrinthFilterVisible, Converter={StaticResource BoolToVisibility}}">
            <ComboBox Width="140" ItemsSource="{Binding GameVersions}" SelectedItem="{Binding SelectedGameVersion}" ToolTip="游戏版本"/>
            <ComboBox Width="120" Margin="8,0,0,0" ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}" ToolTip="加载器"/>
        </StackPanel>

        <!-- 筛选行：整合包（版本 + 加载器 + 来源） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8"
                    Visibility="{Binding ModpackSourceVisible, Converter={StaticResource BoolToVisibility}}">
            <ComboBox Width="140" ItemsSource="{Binding GameVersions}" SelectedItem="{Binding SelectedGameVersion}" ToolTip="游戏版本"/>
            <ComboBox Width="120" Margin="8,0,0,0" ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}" ToolTip="加载器"/>
            <ComboBox Width="150" Margin="8,0,0,0"
                      ItemsSource="{Binding ModpackSources}" SelectedValue="{Binding SelectedModpackSource}" SelectedValuePath="Id"
                      ToolTip="整合包来源">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                        <Setter Property="ToolTip" Value="{Binding UnavailableReason}"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </StackPanel>

        <!-- 筛选行：Minecraft 版本类型 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8"
                    Visibility="{Binding IsMinecraft, Converter={StaticResource BoolToVisibility}}">
            <ComboBox Width="160" SelectedValue="{Binding SelectedVersionType}" SelectedValuePath="Tag" ToolTip="版本类型">
                <ComboBoxItem Content="全部" Tag="all"/>
                <ComboBoxItem Content="正式版" Tag="release"/>
                <ComboBoxItem Content="快照" Tag="snapshot"/>
                <ComboBoxItem Content="旧版" Tag="old"/>
            </ComboBox>
        </StackPanel>

        <!-- 筛选行：地图（分类 + 版本 + 排序 + 分页） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8"
                    Visibility="{Binding IsMap, Converter={StaticResource BoolToVisibility}}">
            <TextBox Width="180" Text="{Binding MapSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" Padding="6,3" ToolTip="搜索地图关键词"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <Button Content="搜索" Command="{Binding SearchCommand}" Width="60" Padding="0,2" Margin="0,0,8,0"/>
            <ComboBox Width="150" ItemsSource="{Binding MapCategories}" DisplayMemberPath="Name"
                      SelectedValuePath="Id" SelectedValue="{Binding SelectedCategory}" ToolTip="分类"/>
            <ComboBox Width="120" Margin="8,0,0,0" ItemsSource="{Binding MapVersions}"
                      SelectedItem="{Binding SelectedMapVersion}" ToolTip="版本"/>
            <ComboBox Width="120" Margin="8,0,0,0" SelectedValue="{Binding MapSortKey}" SelectedValuePath="Tag" ToolTip="排序">
                <ComboBoxItem Content="最新发布" Tag="published"/>
                <ComboBoxItem Content="最多浏览" Tag="views"/>
            </ComboBox>
            <Button Content="上一页" Command="{Binding ChangeMapPageCommand}" CommandParameter="prev"
                    Margin="8,0,0,0" Padding="8,2"/>
            <Button Content="下一页" Command="{Binding ChangeMapPageCommand}" CommandParameter="next"
                    Margin="8,0,0,0" Padding="8,2"/>
            <TextBlock Text="{Binding MapPage, StringFormat='第 {0} 页'}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- 卡片网格 -->
        <ScrollViewer Grid.Row="2" Margin="12,0,12,8" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                CornerRadius="10" Margin="6" Width="196">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="110"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource ControlBackground}" CornerRadius="10">
                                    <theme:ExternalIcon Url="{Binding IconUrl}" FallbackToken="{Binding FallbackToken}" CornerRadius="10"/>
                                </Border>

                                <!-- 封面右上角：含附加资源标记（仅地图） -->
                                <Border Grid.Row="0" Style="{StaticResource CardBadgeStyle}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                        Visibility="{Binding HasExtra, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="该地图附带资源包 / 光影，可在详情窗一并安装">
                                    <TextBlock Text="含附加资源" Style="{StaticResource CardBadgeTextStyle}"/>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold"
                                           Margin="10,8,10,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <TextBlock Grid.Row="2" Text="{Binding Author}" FontSize="11" Opacity="0.7" Margin="10,0,10,2"/>

                                <!-- 浏览量（规格 2.2：地图卡片展示封面 / 标题 / 作者 / 浏览量） -->
                                <TextBlock Grid.Row="3" Text="{Binding ViewsText}" FontSize="11" Margin="10,0,10,2"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding ViewsText, Converter={StaticResource NonEmptyToVisibility}}"/>

                                <!-- 整合包元信息行（加载器 · 版本 · 下载量） -->
                                <TextBlock Grid.Row="3" Text="{Binding MetaText}" FontSize="11" Margin="10,0,10,2"
                                           Foreground="{DynamicResource AccentBrush}" Opacity="0.9"
                                           Visibility="{Binding MetaText, Converter={StaticResource NonEmptyToVisibility}}"/>

                                <TextBlock Grid.Row="4" Text="{Binding Summary}" FontSize="11" Opacity="0.7"
                                           Margin="10,0,10,2" TextWrapping="Wrap" Height="32" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="10,6,10,8">
                                    <Button
                                            Command="{Binding DataContext.EnqueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="6,2">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Content" Value="加入队列"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="Minecraft">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="6,0,0,0" Padding="6,2">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="详情"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="Minecraft">
                                                        <Setter Property="Content" Value="安装"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 下载队列 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,0,12,4">
            <Button Content="开始下载队列" Command="{Binding StartQueueCommand}" Width="130" Padding="0,4"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <TextBlock Text="{Binding Queue.Count, StringFormat='共 {0} 项'}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"/>
        </StackPanel>
        <ListBox Grid.Row="4" ItemsSource="{Binding Queue}" Margin="12,0,12,12"
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                 BorderBrush="{DynamicResource InputBorder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="Bold" Text="{Binding Title}"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="10"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressBackground}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="暂停"
                                Command="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Padding="2" Margin="4,0"/>
                        <Button Grid.Column="3" Content="取消"
                                Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Padding="2"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 地图详情弹窗（规格 2.2：大图、描述、下载 / 附加资源按钮） -->
        <Grid Grid.RowSpan="5" Style="{StaticResource ModalOverlayStyle}"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource ModalCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="18" Width="560" MaxHeight="620">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题行 -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="关闭" Command="{Binding CloseDetailCommand}" Padding="10,2"/>
                        <TextBlock Text="{Binding CurrentMapDetail.Title}" FontWeight="Bold" FontSize="17"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentMapDetail.Title}"/>
                    </DockPanel>

                    <!-- 大图 -->
                    <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" CornerRadius="8" Margin="0,12,0,0">
                        <theme:ExternalIcon Url="{Binding CurrentMapDetail.CoverImageUrl}" FallbackToken="map" CornerRadius="8"/>
                    </Border>

                    <!-- 元信息：作者 / 浏览 / 点赞 / 评分 -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="作者" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentMapDetail.Author}" Style="{StaticResource DetailMetaValueStyle}" FontWeight="Bold"/>
                        <TextBlock Text="浏览" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentMapDetail.Views}" Style="{StaticResource DetailMetaValueStyle}"/>
                        <TextBlock Text="点赞" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentMapDetail.Likes}" Style="{StaticResource DetailMetaValueStyle}"/>
                        <TextBlock Text="评分" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentMapDetail.RatingSummary}" Style="{StaticResource DetailMetaValueStyle}"/>
                    </WrapPanel>

                    <!-- 版本 / 分类 -->
                    <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="版本" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentMapDetail.VersionSummary}" Style="{StaticResource DetailMetaValueStyle}"/>
                        <TextBlock Text="分类" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentMapDetail.CategorySummary}" Style="{StaticResource DetailMetaValueStyle}"/>
                    </WrapPanel>

                    <!-- 描述（Markdown 已在 Core 转纯文本） -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" MinHeight="60">
                        <TextBlock Text="{Binding CurrentMapDetail.DescriptionText}" TextWrapping="Wrap"
                                   Opacity="0.85" LineHeight="20"/>
                    </ScrollViewer>

                    <!-- 提示行：下载进度 / 安装结果 / 未授权说明 -->
                    <TextBlock Grid.Row="5" Text="{Binding DetailHint}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource AccentBrush}" FontSize="12"
                               Visibility="{Binding DetailHint, Converter={StaticResource NonEmptyToVisibility}}"/>

                    <!-- 操作行 -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="地图站页面" Command="{Binding OpenMapPageCommand}"
                                Style="{StaticResource GhostButtonStyle}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="附加资源" Command="{Binding DownloadExtraCommand}" Padding="10,4" Margin="0,0,8,0"
                                ToolTip="下载资源包 / 光影并自动分发到 resourcepacks、shaderpacks"
                                Visibility="{Binding DetailHasExtra, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="下载到存档" Command="{Binding DownloadDetailCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="10,4"
                                Visibility="{Binding DetailCanDownload, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 整合包详情弹窗（规格 2.2：在线浏览 Modrinth，一键安装） -->
        <Grid Grid.RowSpan="5" Style="{StaticResource ModalOverlayStyle}"
              Visibility="{Binding IsModpackDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource ModalCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="18" Width="560" MaxHeight="640">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题行 -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="关闭" Command="{Binding CloseModpackDetailCommand}" Padding="10,2"/>
                        <TextBlock Text="{Binding CurrentModpackDetail.Title}" FontWeight="Bold" FontSize="17"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentModpackDetail.Title}"/>
                    </DockPanel>

                    <!-- 封面 -->
                    <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" CornerRadius="8" Margin="0,12,0,0">
                        <theme:ExternalIcon Url="{Binding CurrentModpackDetail.IconUrl}" FallbackToken="pack" CornerRadius="8"/>
                    </Border>

                    <!-- 元信息：作者 / 下载 / 加载器 / 版本 -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="作者" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentModpackDetail.Author}" Style="{StaticResource DetailMetaValueStyle}" FontWeight="Bold"/>
                        <TextBlock Text="下载" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentModpackDetail.DownloadsText}" Style="{StaticResource DetailMetaValueStyle}"/>
                        <TextBlock Text="加载器" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding ModpackDetailLoaders}" Style="{StaticResource DetailMetaValueStyle}"/>
                        <TextBlock Text="版本" Style="{StaticResource DetailMetaLabelStyle}"/>
                        <TextBlock Text="{Binding ModpackDetailLatestVersion}" Style="{StaticResource DetailMetaValueStyle}"/>
                    </WrapPanel>

                    <!-- 版本选择 -->
                    <StackPanel Grid.Row="3" Margin="0,8,0,0"
                                Visibility="{Binding CurrentModpackDetail.HasVersions, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="选择版本" FontSize="12" Opacity="0.8" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CurrentModpackDetail.Versions}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedItem="{Binding SelectedModpackVersion}"
                                  MaxDropDownHeight="220"/>
                    </StackPanel>

                    <!-- 安装选项：隔离开关（整合包以独立版本隔离目录安装） -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding InstallIsolated, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="隔离安装（独立 versions/&lt;包名&gt; 目录）" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="{DynamicResource PrimaryForeground}"/>
                    </StackPanel>

                    <!-- 描述 -->
                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" MinHeight="40">
                        <TextBlock Text="{Binding CurrentModpackDetail.Description}" TextWrapping="Wrap"
                                   Opacity="0.85" LineHeight="20"/>
                    </ScrollViewer>

                    <!-- 提示行：安装进度 / 结果 / 不可安装说明 -->
                    <TextBlock Grid.Row="6" Text="{Binding ModpackDetailHint}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource AccentBrush}" FontSize="12"
                               Visibility="{Binding ModpackDetailHint, Converter={StaticResource NonEmptyToVisibility}}"/>

                    <!-- 操作行 -->
                    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="来源页面" Command="{Binding OpenModpackPageCommand}"
                                Style="{StaticResource GhostButtonStyle}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="安装" Command="{Binding InstallModpackCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="10,4"
                                Visibility="{Binding ModpackDetailCanInstall, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Minecraft 版本安装弹窗 -->
        <Grid Grid.RowSpan="5" Style="{StaticResource ModalOverlayStyle}"
              Visibility="{Binding IsInstallOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource ModalCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="16" Width="420">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="关闭" Command="{Binding CloseInstallCommand}" Padding="10,2"/>
                        <TextBlock Text="安装 Minecraft 版本" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Margin="0,10,0,0">
                        <Run Text="版本："/>
                        <Run Text="{Binding CurrentInstallVersion.Title}" FontWeight="Bold"/>
                    </TextBlock>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="选择加载器（可不选）" Margin="0,0,0,6" Opacity="0.8"/>
                        <ListBox SelectedValue="{Binding SelectedInstallLoader}" SelectedValuePath="Tag"
                                 BorderThickness="0" Background="Transparent">
                            <ListBoxItem Content="原版（不安装加载器）" Tag="none"/>
                            <ListBoxItem Content="Forge" Tag="forge"/>
                            <ListBoxItem Content="Fabric（自动配对最新 Fabric API）" Tag="fabric"/>
                            <ListBoxItem Content="NeoForge" Tag="neoforge"/>
                            <ListBoxItem Content="Quilt" Tag="quilt"/>
                        </ListBox>
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInstallLoader}" Value="fabric">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            选择 Fabric 时将自动安装最新正式版 Fabric API 到 mods 目录。
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding InstallStatus}"
                               TextWrapping="Wrap" Opacity="0.85"/>
                    <ProgressBar Grid.Row="4" Margin="0,10,0,0" Height="8" IsIndeterminate="True"
                                 Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}"/>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="取消" Command="{Binding CloseInstallCommand}" Margin="0,0,8,0" Padding="10,4"/>
                        <Button Content="加入队列" Command="{Binding EnqueueInstallCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="10,4"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
