<UserControl x:Class="MCLCS.App.Views.AiAssistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels">
    <UserControl.DataContext>
        <vm:AiAssistViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧功能列表 ===== -->
        <ListBox Grid.Column="0" ItemsSource="{Binding Functions}"
                 SelectedItem="{Binding SelectedFunction}"
                 Background="{DynamicResource ControlBackground}"
                 BorderBrush="{DynamicResource ControlBorder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="40" Cursor="Hand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="14"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"
                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== 右侧内容区（按功能切换） ===== -->
        <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 崩溃解读 -->
                <StackPanel Visibility="{Binding ShowCrash, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="崩溃解读" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding CrashText, UpdateSourceTrigger=PropertyChanged}" Height="180"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                             BorderBrush="{DynamicResource InputBorder}"/>
                    <Button Content="解读" Command="{Binding InterpretCommand}" Width="80"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="0,4" Margin="0,8,0,0"/>
                    <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Interpretation}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                    </Border>
                </StackPanel>

                <!-- 推荐理由 -->
                <StackPanel Visibility="{Binding ShowRecommend, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="配装推荐 / 推荐理由" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding RecommendInput, UpdateSourceTrigger=PropertyChanged}" Height="100"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                             BorderBrush="{DynamicResource InputBorder}"
                             ToolTip="描述你的玩法偏好，AI 会推荐适合的 Mod"/>
                    <Button Content="推荐" Command="{Binding RecommendCommand}" Width="80"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="0,4" Margin="0,8,0,0"/>
                    <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <TextBlock Text="{Binding RecommendOutput}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                    </Border>
                </StackPanel>

                <!-- Mod 翻译 -->
                <StackPanel Visibility="{Binding ShowTranslate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Mod 描述翻译" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ModText, UpdateSourceTrigger=PropertyChanged}" Height="180"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                             BorderBrush="{DynamicResource InputBorder}"/>
                    <Button Content="翻译" Command="{Binding TranslateCommand}" Width="80"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="0,4" Margin="0,8,0,0"/>
                    <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Translated}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                    </Border>
                </StackPanel>

                <!-- 年度总结 -->
                <StackPanel Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="年度总结" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="根据你的游玩记录，AI 生成一段年度总结。" Margin="0,0,0,8"
                               Foreground="{DynamicResource SecondaryForeground}"/>
                    <Button Content="生成总结" Command="{Binding SummaryCommand}" Width="100"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="0,4"/>
                    <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <TextBlock Text="{Binding AnnualSummary}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
